# O Next carrega os arquivos .env* da RAIZ do projeto — nunca de src/.
# Copie para `.env` e ajuste. Variáveis NEXT_PUBLIC_* vão para o bundle do browser.

# Base URL usada pelo axios no browser. Mantenha relativa: o rewrite do
# next.config.ts repassa /api para PRIVATE_API_URL, o que preserva o cookie
# de sessão como first-party.
NEXT_PUBLIC_API_URL="/api"

# Base URL absoluta do backend. Usada pelo rewrite e pelas chamadas server-side
# (proxy.ts, Server Components), que não passam pelo rewrite.
PRIVATE_API_URL="http://localhost:4000/api"

# Segredo de assinatura do JWT de sessão — precisa ser o MESMO do backend,
# senão o proxy.ts rejeita todo token válido.
SESSION_SECRET="troque-este-valor-em-producao"

# CDN de arquivos (logos, anexos). Opcional.
NEXT_PUBLIC_FILES_API_URL=""
