{
  "compilerOptions": {
    "lib": ["ES2023"],
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "test", "knexfile.ts"],
  "exclude": ["node_modules", "dist"]
}
