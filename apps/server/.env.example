NODE_ENV="development"
PORT="4000"
HOST="0.0.0.0"
DATABASE_URL="postgresql://docker:docker@localhost:5440/triar_app"
ORIGINS="http://localhost:3000"

# Assina o cookie de sessão (login da unidade). Precisa ser o MESMO do web.
SESSION_SECRET="troque-este-valor-em-producao"

# Assina o token do cartão de triagem (QR code). O resumo vai dentro dele.
CARD_SECRET="troque-este-valor-tambem-em-producao"

# Sem a chave, POST /api/triage responde 503 (as regras de sinal grave continuam valendo).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
